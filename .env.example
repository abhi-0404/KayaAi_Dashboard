# Supabase — client-side (prefixed with VITE_ for Vite build-time injection)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_publishable_key

# Supabase — server-side (used in Nitro / server functions only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # NEVER expose to the client

# Local dev only — place in .env.local (gitignored)
# Set to "true" to bypass authentication on localhost
# VITE_DEV_AUTH_BYPASS=true
